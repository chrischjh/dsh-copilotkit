{
  "name": "dsh-copilotkit",
  "description": "CopilotKit developer kit for DeepSeek Harness: the official CopilotKit agent skills plus the copilotkit docs MCP server, a detail-page self-check button, and a read-only self-check tool — so agents build on the library instead of re-inventing it",
  "version": "0.2.5",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "scripts": {
    "test": "node --test",
    "sync": "node scripts/sync-skills.mjs"
  },
  "files": [
    "client.js",
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "skills",
    "skills.lock.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "author": {
    "name": "Chris Chen"
  },
  "homepage": "https://github.com/chrischjh/dsh-copilotkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrischjh/dsh-copilotkit.git"
  },
  "bugs": {
    "url": "https://github.com/chrischjh/dsh-copilotkit/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "copilotkit",
    "ag-ui",
    "mcp",
    "skills",
    "self-check"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
